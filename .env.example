# Django
SECRET_KEY=dev
DEBUG=1
ALLOWED_HOSTS=*

# Database (PostgreSQL)
# DB_ENGINE can be set to 'sqlite' for a quick local run (not recommended for prod)
DB_ENGINE=postgresql
DB_NAME=capstone
DB_USER=capstone
DB_PASSWORD=capstone
DB_HOST=localhost
DB_PORT=5432

# Redis (optional)
REDIS_URL=redis://127.0.0.1:6379/0

# Server RSA keys
SERVER_RSA_PRIV_PATH=secrets/server_rsa_priv.pem
SERVER_RSA_PUB_PATH=secrets/server_rsa_pub.pem
# NOTE: Keys in secrets/ are dummy and for local dev & CI only.
# Replace with secure generated 2048-bit (or higher) RSA keys in production and never commit real secrets.

# OCR
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Throttle rates
THROTTLE_RATE_USER=100/min
THROTTLE_RATE_INGEST=10/min
THROTTLE_RATE_DECRYPT=20/min

# Dev helpers
ALLOW_DEV_ENDPOINTS=1
